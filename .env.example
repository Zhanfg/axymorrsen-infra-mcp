# This file contains placeholders only.
# Never commit real provider credentials.

MCP_LOG_LEVEL=info

# Local bootstrap defaults.
MCP_BIND_HOST=127.0.0.1
MCP_PORT=3000

# Production resource URL. Use the exact public MCP endpoint including /mcp.
MCP_PUBLIC_MCP_URL=https://mcp.example.com/mcp

# Optional explicit allowlists. Comma-separated.
MCP_ALLOWED_HOSTS=mcp.example.com
MCP_ALLOWED_ORIGINS=https://mcp.example.com

# OAuth/OIDC resource-server verification.
# Use the exact issuer string published by your IdP.
MCP_AUTH_ISSUER=https://auth.example.com/
MCP_AUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json
MCP_AUTH_AUDIENCE=https://mcp.example.com/mcp
MCP_AUTH_REQUIRED_SCOPES=mcp
MCP_AUTH_ALGORITHMS=RS256,PS256,ES256,EdDSA
MCP_AUTH_CLIENT_ID_CLAIMS=client_id,azp

# Secret backend
SECRET_BACKEND=vault
VAULT_ADDR=https://vault.example.com
VAULT_AUTH_METHOD=oidc

# Provider credentials are resolved server-side and MUST NOT be exposed to clients.
GITHUB_CREDENTIAL_REF=secret/providers/github
GITLAB_CREDENTIAL_REF=secret/providers/gitlab
CLOUDFLARE_CREDENTIAL_REF=secret/providers/cloudflare
CIRCLECI_CREDENTIAL_REF=secret/providers/circleci
