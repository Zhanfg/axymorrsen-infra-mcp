# This file contains placeholders only.
# Never commit real provider credentials.

MCP_LOG_LEVEL=info
MCP_BIND_HOST=127.0.0.1
MCP_PORT=3000

# Authentication modes:
# - disabled: local loopback development only
# - jwt: remote OAuth resource-server mode using an external authorization server
MCP_AUTH_MODE=disabled

# Full public MCP resource URL. Required when MCP_AUTH_MODE=jwt.
MCP_PUBLIC_URL=https://mcp.example.com/mcp

# External OAuth/OIDC authorization server. Required in jwt mode.
MCP_AUTH_ISSUER_URL=https://auth.example.com
MCP_AUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json
MCP_AUTHORIZATION_ENDPOINT=https://auth.example.com/oauth2/authorize
MCP_TOKEN_ENDPOINT=https://auth.example.com/oauth2/token

# Optional authorization-server capabilities.
# MCP_REGISTRATION_ENDPOINT=https://auth.example.com/oauth2/register
# MCP_AUTH_CLIENT_ID_METADATA_DOCUMENT_SUPPORTED=true

# The JWT audience defaults to MCP_PUBLIC_URL when omitted.
# MCP_AUTH_AUDIENCE=https://mcp.example.com/mcp

# Space- or comma-separated OAuth scopes.
MCP_AUTH_REQUIRED_SCOPES=infra:connect
MCP_AUTH_SCOPES_SUPPORTED=infra:connect

# Requests with an Origin header are denied unless the origin is listed here.
# Non-browser MCP clients normally omit Origin.
# MCP_ALLOWED_ORIGINS=https://trusted-client.example.com

# Additional accepted Host header names. MCP_PUBLIC_URL hostname is always allowed.
# MCP_ALLOWED_HOSTS=mcp-internal.example.net

# Local development escape hatch for an http:// localhost authorization server.
# Never enable this in production.
MCP_AUTH_ALLOW_INSECURE_LOCALHOST=false

# The first secret backend is environment-backed. Inject the values through the
# deployment platform's secret store; never commit a real .env file.
SECRET_BACKEND=env
GITHUB_CREDENTIAL_REF=env:GITHUB_TOKEN
GITLAB_CREDENTIAL_REF=env:GITLAB_TOKEN
CLOUDFLARE_CREDENTIAL_REF=env:CLOUDFLARE_API_TOKEN
CIRCLECI_CREDENTIAL_REF=env:CIRCLECI_TOKEN
VERCEL_CREDENTIAL_REF=env:VERCEL_TOKEN
RAILWAY_CREDENTIAL_REF=env:RAILWAY_TOKEN
SUPABASE_CREDENTIAL_REF=env:SUPABASE_ACCESS_TOKEN
SENTRY_CREDENTIAL_REF=env:SENTRY_AUTH_TOKEN
TERRAFORM_CREDENTIAL_REF=env:TFC_TOKEN

# Optional provider API bases for GitHub Enterprise / self-managed GitLab / tests.
# GITHUB_API_BASE_URL=https://api.github.com/
# GITLAB_API_BASE_URL=https://gitlab.example.com/api/v4/
# CLOUDFLARE_API_BASE_URL=https://api.cloudflare.com/client/v4/
# CIRCLECI_API_BASE_URL=https://circleci.com/api/v2/
# VERCEL_API_BASE_URL=https://api.vercel.com/
# RAILWAY_API_BASE_URL=https://backboard.railway.com/graphql/v2
# SUPABASE_API_BASE_URL=https://api.supabase.com/
# SENTRY_API_BASE_URL=https://sentry.io/api/0/
# TERRAFORM_API_BASE_URL=https://app.terraform.io/api/v2/

# Real values are supplied out-of-band by the deployment secret store:
# GITHUB_TOKEN=YOUR_GITHUB_TOKEN_HERE
# GITLAB_TOKEN=YOUR_GITLAB_TOKEN_HERE
# CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN_HERE
# CIRCLECI_TOKEN=YOUR_CIRCLECI_TOKEN_HERE
# VERCEL_TOKEN=YOUR_VERCEL_TOKEN_HERE
# RAILWAY_TOKEN=YOUR_RAILWAY_TOKEN_HERE
# SUPABASE_ACCESS_TOKEN=YOUR_SUPABASE_ACCESS_TOKEN_HERE
# SENTRY_AUTH_TOKEN=YOUR_SENTRY_AUTH_TOKEN_HERE
# TFC_TOKEN=YOUR_TFC_TOKEN_HERE
