# This file contains placeholders only.
# Never commit real provider credentials.

MCP_LOG_LEVEL=info
MCP_BIND_HOST=127.0.0.1
MCP_PORT=3000

# Authentication modes:
# - disabled: local loopback development only
# - jwt: local JWT signature verification through JWKS
# - introspection: OAuth token introspection (supports opaque or JWT access tokens)
MCP_AUTH_MODE=disabled

# Full public MCP resource URL.
MCP_PUBLIC_URL=https://mcp.example.com/mcp

# External OAuth/OIDC authorization server.
MCP_AUTH_ISSUER_URL=https://auth.example.com
MCP_AUTHORIZATION_ENDPOINT=https://auth.example.com/oauth2/authorize
MCP_TOKEN_ENDPOINT=https://auth.example.com/oauth2/token

# Optional Dynamic Client Registration.
# MCP_REGISTRATION_ENDPOINT=https://auth.example.com/oauth2/register
# MCP_AUTH_CLIENT_ID_METADATA_DOCUMENT_SUPPORTED=true

# JWT mode only.
# MCP_AUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json
# MCP_AUTH_AUDIENCE_MODE=exact
# MCP_AUTH_AUDIENCE=https://mcp.example.com/mcp

# Introspection mode only.
# Use an API application credential dedicated to this MCP resource server.
# MCP_AUTH_INTROSPECTION_ENDPOINT=https://auth.example.com/oauth/v2/introspect
# MCP_AUTH_INTROSPECTION_CLIENT_ID=<resource-server-client-id>
# MCP_AUTH_INTROSPECTION_CLIENT_SECRET=<REDACTED>
# Optional additional aud check, e.g. a ZITADEL project ID.
# MCP_AUTH_INTROSPECTION_AUDIENCE=<project-id>

# Space- or comma-separated OAuth scopes.
MCP_AUTH_REQUIRED_SCOPES=infra:connect
MCP_AUTH_SCOPES_SUPPORTED=infra:connect

# Requests with an Origin header are denied unless listed.
# MCP_ALLOWED_ORIGINS=https://trusted-client.example.com
# MCP_ALLOWED_HOSTS=mcp-internal.example.net

MCP_AUTH_ALLOW_INSECURE_LOCALHOST=false

# Secret backends for infrastructure provider credentials.
SECRET_BACKEND=env
# SECRET_BACKEND=env,vault-kv2
# VAULT_ADDR=https://vault.example.com
# VAULT_TOKEN=<REDACTED>

GITHUB_CREDENTIAL_REF=env:GITHUB_TOKEN
GITLAB_CREDENTIAL_REF=env:GITLAB_TOKEN
CLOUDFLARE_CREDENTIAL_REF=env:CLOUDFLARE_API_TOKEN
CIRCLECI_CREDENTIAL_REF=env:CIRCLECI_TOKEN
VERCEL_CREDENTIAL_REF=env:VERCEL_TOKEN
RAILWAY_CREDENTIAL_REF=env:RAILWAY_TOKEN
SUPABASE_CREDENTIAL_REF=env:SUPABASE_ACCESS_TOKEN
SENTRY_CREDENTIAL_REF=env:SENTRY_AUTH_TOKEN
TERRAFORM_CREDENTIAL_REF=env:TFC_TOKEN
DOCKERHUB_IDENTIFIER_REF=env:DOCKERHUB_IDENTIFIER
DOCKERHUB_SECRET_REF=env:DOCKERHUB_SECRET
KUBERNETES_CREDENTIAL_REF=env:KUBERNETES_TOKEN
KUBERNETES_CLUSTER_ID=default-cluster
VAULT_CREDENTIAL_REF=env:VAULT_TOKEN
VAULT_INSTANCE_ID=default-vault
# VAULT_NAMESPACE=

# Optional provider API bases.
# GITHUB_API_BASE_URL=https://api.github.com/
# GITLAB_API_BASE_URL=https://gitlab.example.com/api/v4/
# CLOUDFLARE_API_BASE_URL=https://api.cloudflare.com/client/v4/
# CIRCLECI_API_BASE_URL=https://circleci.com/api/v2/
# VERCEL_API_BASE_URL=https://api.vercel.com/
# RAILWAY_API_BASE_URL=https://backboard.railway.com/graphql/v2
# SUPABASE_API_BASE_URL=https://api.supabase.com/
# SENTRY_API_BASE_URL=https://sentry.io/api/0/
# TERRAFORM_API_BASE_URL=https://app.terraform.io/api/v2/
# DOCKERHUB_API_BASE_URL=https://hub.docker.com/
# KUBERNETES_API_BASE_URL=https://kubernetes.default.svc/
# VAULT_API_BASE_URL=https://127.0.0.1:8200/v1/

# Backward-compatible aliases (canonical MCP_AUTH_* names take precedence).
# ZITADEL_ISSUER=https://instance.zitadel.cloud
# ZITADEL_INTROSPECTION_URL=https://instance.zitadel.cloud/oauth/v2/introspect
# ZITADEL_CLIENT_ID=<API_CLIENT_ID>
# ZITADEL_CLIENT_SECRET=YOUR_CLIENT_SECRET_HERE

# Optional deployed integration test. Supply secrets through the CI secret store.
# MCP_INTEGRATION_URL=https://staging-mcp.example.com/mcp
# MCP_INTEGRATION_TOKEN_ENDPOINT=https://instance.zitadel.cloud/oauth/v2/token
# MCP_INTEGRATION_CLIENT_ID=<TEST_CLIENT_ID>
# MCP_INTEGRATION_CLIENT_SECRET=YOUR_CLIENT_SECRET_HERE
# MCP_INTEGRATION_REFRESH_TOKEN=<REDACTED>
# MCP_INTEGRATION_ACCESS_TOKEN=YOUR_TOKEN_HERE
# MCP_INTEGRATION_SCOPE=openid
# MCP_INTEGRATION_EXPECTED_SUBJECT=<EXPECTED_TEST_SUBJECT>
